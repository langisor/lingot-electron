# Copy to electron-builder.env for local signed builds.
# Never commit the real electron-builder.env file.

# macOS signing certificate, usually a base64-encoded Developer ID Application .p12.
CSC_LINK=
CSC_KEY_PASSWORD=

# Windows signing certificate, usually a base64-encoded Authenticode .pfx.
WIN_CSC_LINK=
WIN_CSC_KEY_PASSWORD=

# macOS notarization. Prefer the Apple API key trio when possible.
APPLE_API_KEY=
APPLE_API_KEY_ID=
APPLE_API_ISSUER=

# Alternative macOS notarization method.
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=
